APP_NAME=CinemaBooking API
DEBUG=false

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cinema_booking

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: an admin is created on startup if it does not exist yet
FIRST_ADMIN_EMAIL=admin@cinema.com
FIRST_ADMIN_PASSWORD=admin12345
